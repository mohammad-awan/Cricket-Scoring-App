APP_NAME=Cricket Intelligence Platform
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# Recommended for local computers using IPv4:
# Supabase Session Pooler on port 5432.
#
# Copy this from:
# Supabase Dashboard -> Connect -> Session pooler
#
# URL-encode special characters in the database password.
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REFERENCE:YOUR_PASSWORD@YOUR_SESSION_POOLER_HOST:5432/postgres?sslmode=require
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_RECYCLE=1800