APP_NAME=Cricket Intelligence Platform
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# Recommended for local computers using IPv4:
# Supabase Session Pooler on port 5432.
#
# Copy this from:
# Supabase Dashboard -> Connect -> Session pooler
#
# URL-encode special characters in the database password.
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REFERENCE:YOUR_PASSWORD@YOUR_SESSION_POOLER_HOST:5432/postgres?sslmode=require
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_RECYCLE=1800
# Stage 11: shared organizer token for tournament mutations.
# Leave unset in development; required outside development/test.
# ORGANIZER_API_TOKEN=change-me

# Stage 11: tournament logo/cover uploads (PNG, JPEG, WebP).
MEDIA_ROOT=media
TOURNAMENT_ASSET_MAX_BYTES=2097152
